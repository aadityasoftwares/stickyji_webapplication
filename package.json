{
  "name": "mystickynotes-webapp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:select": "ng test --watch=false --ts-config tsconfig.select-regression.json --include src/app/shared/components/select/select.spec.ts --include src/app/shared/components/side-panel/side-panel.spec.ts --include src/app/private/mynotes/add-edit-note-side-panel/add-edit-note-side-panel.spec.ts --include src/app/private/sticky-note-columns/add-edit-sticky-note-column-side-panel/add-edit-sticky-note-column-side-panel.spec.ts",
    "test:priority": "ng test --watch=false --ts-config tsconfig.priority-regression.json --include src/app/private/mynotes/add-edit-note-side-panel/add-edit-note-side-panel.spec.ts --include src/app/private/sticky-note-columns/add-edit-sticky-note-column-side-panel/add-edit-sticky-note-column-side-panel.spec.ts --include src/app/shared/components/side-panel/side-panel.spec.ts",
    "test:dates": "ng test --watch=false --ts-config tsconfig.user-date-regression.json --include src/app/shared/services/user-date-time-formatter.service.spec.ts --include src/app/shared/pipes/user-date.pipe.spec.ts --include src/app/private/workspace/workspace.spec.ts --include src/app/private/workspace/workspace-trash/workspace-trash.spec.ts --include src/app/private/user-preferences/services/user-preference.store.spec.ts --include src/app/private/user-preferences/user-preferences/user-preferences.spec.ts --include src/app/guards/auth.guard.spec.ts",
    "test:overdue": "ng test --watch=false --ts-config tsconfig.overdue-regression.json --include src/app/private/mynotes/services/overdue-notes.store.spec.ts --include src/app/private/mynotes/overdue-notes-panel/overdue-notes-panel.spec.ts --include src/app/private/mynotes/mynotes.spec.ts --include src/app/private/mynotes/add-edit-note-side-panel/add-edit-note-side-panel.spec.ts --include src/app/private/today/today.spec.ts --include src/app/shared/components/side-panel/side-panel.spec.ts",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\""
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@lucide/angular": "^1.34.0",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
